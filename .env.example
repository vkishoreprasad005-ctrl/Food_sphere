# GEMINI_API_KEY: Optional for AI assistant/features
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted
APP_URL="http://localhost:3000"
PORT=3000

# Authentication Secret (JWT signing)
AUTH_SECRET="foodsphere_super_secret_jwt_key_development_change_in_production"

# Database Configuration (Optional MongoDB URI; falls back to embedded resilient file/in-memory data layer with automatic seed)
MONGODB_URI="mongodb+srv://<username>:<password>@cluster0.mongodb.net/foodsphere?retryWrites=true&w=majority"

# Stripe Payment Gateway (Optional test keys for online checkout)
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Cloudinary Cloud Image Storage (Optional credentials for direct cloud upload)
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"
